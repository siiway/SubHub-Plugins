    "plugin",
    "subscription",
    "parser",
    "clash",
    "v2ray",
    "proxy"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/siiway/SubHub-Plugins.git",
    "directory": "packages/subscription"
  },
  "dependencies": {
    "@siiway/subhub-plugin-sdk": "^0.2.1"
